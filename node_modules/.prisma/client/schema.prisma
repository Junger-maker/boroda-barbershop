generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  service   String
  barber    String?
  date      String?
  time      String?
  consent   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bookings")
}

model Barber {
  id        String     @id @default(cuid())
  name      String     @unique
  years     Int        @default(0)
  spec      String     @default("")
  initials  String     @default("")
  color     String     @default("bg-primary")
  photo     String?
  gradeId   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  grade     Grade?     @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  schedules Schedule[]

  @@map("barbers")
}

model Service {
  id            String         @id @default(cuid())
  name          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  gradeServices GradeService[]

  @@map("services")
}

model Grade {
  id            String         @id @default(cuid())
  name          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  barbers       Barber[]
  gradeServices GradeService[]

  @@map("grades")
}

model GradeService {
  id        String   @id @default(cuid())
  gradeId   String
  serviceId String
  price     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([gradeId, serviceId])
  @@map("grade_services")
}

model Schedule {
  id        String   @id @default(cuid())
  barberId  String
  date      String
  time      String
  available Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@map("schedules")
}
